# Copy this file to ".env" (same folder) and fill in your own values.
# Never share the real .env or upload it to GitHub.
MONGO_URI=mongodb+srv://<db_user>:<db_password>@<cluster>.mongodb.net/collegeHub?retryWrites=true&w=majority
# Optional - a long random text used to sign login tokens. If omitted, a default is used.
JWT_SECRET=change_this_to_any_long_random_text
